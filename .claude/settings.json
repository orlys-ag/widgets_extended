{
  "permissions": {
    "allow": [
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter pub:*)",
      "Bash(python plans/check_citations.py:*)",
      "Bash(node .claude/workflows/feature-delivery.harness.mjs:*)",
      "Bash(python .claude/hooks/deny_forbidden_characters.py --self-test)",
      "Bash(python .claude/hooks/audit_shell_command.py --self-test)",
      "Bash(python .claude/hooks/verify_hooks_load.py)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/forbid_attribution.py\"",
            "timeout": 15,
            "statusMessage": "Checking commit attribution"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deny_forbidden_characters.py\"",
            "timeout": 15,
            "statusMessage": "Checking written text for forbidden characters"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/audit_shell_command.py\"",
            "timeout": 30,
            "statusMessage": "Auditing the command's writes and commit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify_hooks_load.py\"",
            "timeout": 20,
            "statusMessage": "Verifying hook scripts load"
          }
        ]
      }
    ]
  }
}
